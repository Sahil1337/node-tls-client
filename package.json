{
  "name": "node-tls-client",
  "version": "2.2.0",
  "description": "Advanced library based on node-fetch and tls-client.",
  "main": "dist/index.js",
  "typings": "typings/index.d.ts",
  "repository": "https://github.com/Sahil1337/node-tls-client",
  "author": "Sahil1337",
  "license": "GPL-3.0",
  "private": false,
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run docs",
    "pretest": "npm run build",
    "test": "node --test test/download.test.js test/ffi.test.js test/headers.test.js test/misc.test.js test/payload.test.js test/semaphore.test.js",
    "docs": "typedoc --out docs src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "tls-client",
    "node-tls-client",
    "javascript",
    "typescript",
    "tls client",
    "tls",
    "cloudflare"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "koffi": "^2.15.2",
    "tough-cookie": "^4.1.4"
  },
  "files": [
    "dist",
    "typings"
  ],
  "engines": {
    "node": ">=20"
  }
}
