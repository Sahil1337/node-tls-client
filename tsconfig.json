{
  "compilerOptions": {
    "target": "es2022",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./typings",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "commonjs",
    "types": ["node"]
  },
  "include": ["src"]
}
